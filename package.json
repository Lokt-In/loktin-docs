{
  "name": "loktin-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run docs:api && vitepress dev",
    "build": "npm run docs:api && npm run check:snippets && vitepress build",
    "preview": "vitepress preview",
    "docs:api": "typedoc",
    "check:snippets": "tsc -p tsconfig.snippets.json"
  },
  "devDependencies": {
    "@loktin/sdk": "0.5.0",
    "@stellar/stellar-sdk": "17.2.1",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.14.1",
    "typedoc-vitepress-theme": "1.1.4",
    "typescript": "6.0.3",
    "vitepress": "1.6.4",
    "vue": "3.5.44"
  }
}
